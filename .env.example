# Optional AI (LLM) parser — leave unset to use the local parser.
#
# --- Local AI via Ollama (no API key needed) ---
# Start Ollama and pull a model first, then uncomment:
# EATTRACK_LLM_URL=http://localhost:11434/v1/chat/completions
# EATTRACK_LLM_MODEL=llama3.1
#
# --- Read nutrition labels from photos (vision model) ---
# Needs a multimodal model. With Ollama: `ollama pull llama3.2-vision`
# EATTRACK_VISION_MODEL=llama3.2-vision
#
# --- Cloud providers (need an API key) ---
# EATTRACK_LLM_API_KEY=sk-...
# EATTRACK_LLM_URL=https://api.openai.com/v1/chat/completions
# EATTRACK_LLM_MODEL=gpt-4o-mini
# (Groq example: URL=https://api.groq.com/openai/v1/chat/completions, MODEL=llama-3.1-8b-instant)

# Online lookup in the international OpenFoodFacts database (no key needed).
# Enabled by default. Set to 0 to disable and stay fully offline.
# EATTRACK_ONLINE_LOOKUP=1

# Optional: change the port (default 5000)
# PORT=5000
